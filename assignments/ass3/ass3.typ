#import "@preview/touying:0.8.0": *
#import themes.university: *

#show: university-theme.with(
  aspect-ratio: "16-9",
  config-info(
    title: [same data, different viz, what could possibly happen?],
    author: [Roberto Castellotti, Gianluca Bottiglieri, Edoardo Siri],
    date: [26 October 2026],
  ),
  config-colors(
    primary: rgb("#002677"),
    secondary: rgb("#D9D9D6"),
    tertiary: rgb("#002677"),
    neutral-lightest: rgb("#D9D9D6"),
    neutral-darkest: rgb("#25282A"),
  ),
)
#set text(size: 14pt)
#set text(font: "CMU Sans Serif")

#show figure.caption: set text(size: 11pt)
#set figure.caption(separator: [ ])

#let synthetic-note = text(size: 10pt, fill: rgb("#555555"))[
  *Data provenance:* all data shown are synthetic, generated by an LLM.
]

#let data-pair(
  first-path,
  second-path,
  caption,
  height: 235pt,
) = figure(
  block(
    width: 100%,
    grid(
      columns: (1fr, 1fr),
      column-gutter: 1em,
      align(center + horizon, image(
        first-path,
        width: 100%,
        height: height,
        fit: "contain",
      )),
      align(center + horizon, image(
        second-path,
        width: 100%,
        height: height,
        fit: "contain",
      )),
    ),
  ),
  caption: [
    #caption
    #linebreak()
    #synthetic-note
  ],
)

#let data-figure(path, caption, height: 330pt) = figure(
  block(
    height: height,
    width: 100%,
    align(center + horizon, image(path, height: 100%)),
  ),
  caption: [
    #caption
    #linebreak()
    #synthetic-note
  ],
)

#title-slide()

